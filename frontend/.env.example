# Better Auth — générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Postgres (même base que le backend, mais au format "postgresql://", sans "+psycopg")
DATABASE_URL=

# OAuth Google — https://console.cloud.google.com/apis/credentials
# Redirect URI : http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth GitHub — https://github.com/settings/developers
# Callback URL : http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Audience des JWT envoyés au backend (doit correspondre à JWT_AUDIENCE côté FastAPI)
JWT_AUDIENCE=chatify-api

# URL de l'API FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000
